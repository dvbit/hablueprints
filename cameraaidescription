blueprint:
  name: AI Camera Snapshot Describer (Full)
  description: >
    Takes snapshots from one or more cameras, uses an AI agent to describe
    them, stores descriptions in text helpers, logs to the Logbook, sends
    mobile notifications, announces via TTS, and updates a persistent
    notification panel.
  domain: automation
  author: Home Assistant Community
  input:

    # ── CAMERAS ──────────────────────────────────────────────────────────────
    camera_entities:
      name: Cameras
      description: One or more cameras to snapshot.
      selector:
        entity:
          domain: camera
          multiple: true

    snapshot_base_path:
      name: Snapshot Base Path
      description: >
        Base folder for snapshots. Must be inside /config/www/.
        Each camera saves as {base}/{camera_id}.jpg
      default: /config/www/ai_snapshots
      selector:
        text:

    # ── AI ────────────────────────────────────────────────────────────────────
    ai_agent:
      name: AI Conversation Agent
      description: The AI agent used to describe images (e.g. conversation.claude).
      selector:
        entity:
          domain: conversation

    ai_instructions:
      name: AI Instructions
      description: Prompt given to the AI for every camera image.
      default: >
        You are a home security assistant.
        Describe what you see in this camera image clearly and concisely.
        Note any people, vehicles, animals, or unusual activity.
        Keep the description under 3 sentences.
      selector:
        text:
          multiline: true

    # ── TEXT HELPERS ──────────────────────────────────────────────────────────
    text_helper_1:
      name: Text Helper — Camera 1
      description: input_text helper to store the AI description for camera 1.
      selector:
        entity:
          domain: input_text

    text_helper_2:
      name: Text Helper — Camera 2 (optional)
      default: ""
      selector:
        entity:
          domain: input_text

    text_helper_3:
      name: Text Helper — Camera 3 (optional)
      default: ""
      selector:
        entity:
          domain: input_text

    # ── TRIGGER ───────────────────────────────────────────────────────────────
    use_motion_trigger:
      name: Use Motion Sensor Trigger
      description: >
        Enable this to trigger on a binary sensor instead of a time pattern.
      default: false
      selector:
        boolean:

    trigger_entity:
      name: Trigger Entity
      description: >
        Binary sensor to trigger on (only used when Use Motion Sensor Trigger
        is enabled).
      default: "binary_sensor.placeholder"
      selector:
        entity:
          domain: binary_sensor

    time_pattern_minutes:
      name: Time Pattern — Minutes Interval
      description: >
        Used only when Use Motion Sensor Trigger is disabled.
        /5 = every 5 min, /30 = every 30 min, etc.
      default: /30
      selector:
        text:

    # ── COOLDOWN ──────────────────────────────────────────────────────────────
    cooldown_minutes:
      name: Cooldown (minutes)
      description: Minimum time between runs. Set to 0 to disable.
      default: 5
      selector:
        number:
          min: 0
          max: 120
          unit_of_measurement: min
          mode: slider

    use_cooldown_helper:
      name: Enable Cooldown
      description: >
        Enable cooldown tracking. Requires an input_datetime helper below.
      default: false
      selector:
        boolean:

    cooldown_helper:
      name: Cooldown Helper (input_datetime)
      description: >
        An input_datetime (Date and Time) helper to track the last run.
        Only used when Enable Cooldown is on.
      default: "input_datetime.placeholder"
      selector:
        entity:
          domain: input_datetime

    # ── NOTIFICATIONS ─────────────────────────────────────────────────────────
    use_notify:
      name: Enable Mobile Notifications
      default: false
      selector:
        boolean:

    notify_target:
      name: Mobile Notification Target
      description: Notify service, e.g. notify.mobile_app_your_phone.
      default: notify.notify
      selector:
        text:

    notify_title:
      name: Notification Title
      default: "📷 Camera AI Update"
      selector:
        text:

    notify_with_image:
      name: Include image in notification
      default: true
      selector:
        boolean:

    # ── LOGBOOK ───────────────────────────────────────────────────────────────
    logbook_enabled:
      name: Enable Logbook Logging
      default: true
      selector:
        boolean:

    use_logbook_entity:
      name: Use custom Logbook Entity
      description: >
        Enable to associate logbook entries with a specific entity.
        If disabled, the camera entity is used.
      default: false
      selector:
        boolean:

    logbook_entity:
      name: Logbook Entity
      description: Only used when Use custom Logbook Entity is enabled.
      default: "input_text.placeholder"
      selector:
        entity:

    # ── PERSISTENT NOTIFICATIONS ──────────────────────────────────────────────
    persistent_notification_enabled:
      name: Enable Persistent Notification Panel
      description: Creates/updates a persistent notification in the HA sidebar.
      default: true
      selector:
        boolean:

    persistent_notification_id_prefix:
      name: Persistent Notification ID Prefix
      description: Use only letters, numbers and underscores.
      default: ai_camera
      selector:
        text:

    # ── TTS ───────────────────────────────────────────────────────────────────
    tts_enabled:
      name: Enable TTS Announcement
      default: false
      selector:
        boolean:

    tts_target:
      name: TTS Media Player
      description: Only used when Enable TTS Announcement is on.
      default: "media_player.placeholder"
      selector:
        entity:
          domain: media_player

    tts_service:
      name: TTS Service
      description: e.g. tts.cloud_say, tts.google_translate_say, tts.piper
      default: tts.cloud_say
      selector:
        text:

    tts_language:
      name: TTS Language
      description: e.g. en-US, it-IT, de-DE
      default: en-US
      selector:
        text:

    tts_only_when_home:
      name: Announce only when someone is home
      default: true
      selector:
        boolean:

    use_tts_person:
      name: Enable home presence check
      description: >
        Enable to check a person/group entity before announcing.
      default: false
      selector:
        boolean:

    tts_person:
      name: Person / Group to check for home presence
      description: Only used when Enable home presence check is on.
      default: "person.placeholder"
      selector:
        entity:

# ── TRIGGERS ──────────────────────────────────────────────────────────────────
triggers:
  - trigger: state
    entity_id: !input trigger_entity
    to: "on"
    id: sensor_trigger

  - trigger: time_pattern
    minutes: !input time_pattern_minutes
    id: time_trigger

# ── VARIABLES ─────────────────────────────────────────────────────────────────
variables:
  camera_entities: !input camera_entities
  snapshot_base: !input snapshot_base_path
  cooldown_minutes: !input cooldown_minutes
  use_cooldown_helper: !input use_cooldown_helper
  cooldown_helper: !input cooldown_helper
  use_notify: !input use_notify
  notify_target: !input notify_target
  notify_with_image: !input notify_with_image
  logbook_enabled: !input logbook_enabled
  use_logbook_entity: !input use_logbook_entity
  logbook_entity: !input logbook_entity
  persistent_notification_enabled: !input persistent_notification_enabled
  persistent_notification_id_prefix: !input persistent_notification_id_prefix
  tts_enabled: !input tts_enabled
  tts_target: !input tts_target
  tts_service: !input tts_service
  tts_language: !input tts_language
  tts_only_when_home: !input tts_only_when_home
  use_tts_person: !input use_tts_person
  tts_person: !input tts_person
  use_motion_trigger: !input use_motion_trigger
  text_helpers:
    - !input text_helper_1
    - !input text_helper_2
    - !input text_helper_3

# ── CONDITIONS ────────────────────────────────────────────────────────────────
conditions:
  # If motion trigger is enabled, only allow sensor_trigger; else only time_trigger
  - condition: template
    value_template: >
      {% if use_motion_trigger %}
        {{ trigger.id == 'sensor_trigger' }}
      {% else %}
        {{ trigger.id == 'time_trigger' }}
      {% endif %}

  # Cooldown gate
  - condition: template
    value_template: >
      {% if not use_cooldown_helper or cooldown_minutes == 0 %}
        true
      {% else %}
        {% set last = states(cooldown_helper) %}
        {% if last in ['unknown', 'unavailable', ''] %}
          true
        {% else %}
          {{ (now() - strptime(last, '%Y-%m-%d %H:%M:%S')).total_seconds() > cooldown_minutes * 60 }}
        {% endif %}
      {% endif %}

# ── ACTIONS ───────────────────────────────────────────────────────────────────
actions:

  # ── Stamp cooldown ──────────────────────────────────────────────────────────
  - alias: Update cooldown timestamp
    if:
      - condition: template
        value_template: "{{ use_cooldown_helper and cooldown_minutes > 0 }}"
    then:
      - action: input_datetime.set_datetime
        data:
          entity_id: "{{ cooldown_helper }}"
          datetime: "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}"

  # ── Per-camera loop ─────────────────────────────────────────────────────────
  - alias: Process each camera
    repeat:
      for_each: "{{ camera_entities }}"
      sequence:

        - variables:
            current_camera: "{{ repeat.item }}"
            camera_label: "{{ repeat.item.split('.')[1] | replace('_', ' ') | title }}"
            snapshot_file: "{{ snapshot_base }}/{{ repeat.item.split('.')[1] }}.jpg"
            local_url: "/local/{{ snapshot_base | replace('/config/www/', '') }}/{{ repeat.item.split('.')[1] }}.jpg"
            current_helper: >
              {{ text_helpers[repeat.index - 1]
                 if repeat.index <= text_helpers | length
                 else '' }}
            notification_id: >
              {{ persistent_notification_id_prefix }}_{{ repeat.item.split('.')[1] }}
            resolved_logbook_entity: >
              {{ logbook_entity if use_logbook_entity else repeat.item }}

        # 1. Snapshot
        - alias: "Take snapshot — {{ current_camera }}"
          action: camera.snapshot
          data:
            entity_id: "{{ current_camera }}"
            filename: "{{ snapshot_file }}"

        - delay:
            seconds: 1

        # 2. AI description
        - alias: "AI describe — {{ current_camera }}"
          action: ai_task.generate_data
          data:
            task_name: "Describe snapshot from {{ current_camera }}"
            model: !input ai_agent
            instructions: !input ai_instructions
            image_urls:
              - "{{ local_url }}"
          response_variable: ai_response

        # 3. Store in text helper
        - alias: Store in text helper
          if:
            - condition: template
              value_template: >
                {{ current_helper != '' and
                   not current_helper.endswith('placeholder') }}
          then:
            - action: input_text.set_value
              data:
                entity_id: "{{ current_helper }}"
                value: "{{ ai_response.text }}"

        # 4. Logbook
        - alias: Logbook entry
          if:
            - condition: template
              value_template: "{{ logbook_enabled }}"
          then:
            - action: logbook.log
              data:
                name: "AI Camera — {{ camera_label }}"
                message: "{{ ai_response.text }}"
                entity_id: "{{ resolved_logbook_entity }}"

        # 5. Mobile notification
        - alias: Mobile notification
          if:
            - condition: template
              value_template: "{{ use_notify }}"
          then:
            - action: "{{ notify_target }}"
              data:
                title: !input notify_title
                message: "📍 {{ camera_label }}: {{ ai_response.text }}"
                data: >
                  {% if notify_with_image %}
                  {"image": "{{ local_url }}"}
                  {% else %}
                  {}
                  {% endif %}

        # 6. Persistent notification
        - alias: Persistent notification
          if:
            - condition: template
              value_template: "{{ persistent_notification_enabled }}"
          then:
            - action: persistent_notification.create
              data:
                notification_id: "{{ notification_id }}"
                title: "📷 {{ camera_label }}"
                message: >
                  **{{ now().strftime('%d/%m/%Y %H:%M') }}**

                  {{ ai_response.text }}

                  ![snapshot]({{ local_url }})

        # 7. TTS
        - alias: TTS announcement
          if:
            - condition: template
              value_template: >
                {{ tts_enabled and
                   not tts_target.endswith('placeholder') }}
            - condition: template
              value_template: >
                {% if tts_only_when_home and use_tts_person %}
                  {{ is_state(tts_person, 'home') }}
                {% else %}
                  true
                {% endif %}
          then:
            - action: "{{ tts_service }}"
              data:
                entity_id: "{{ tts_target }}"
                message: "Camera {{ camera_label }}: {{ ai_response.text }}"
                language: "{{ tts_language }}"

        - delay:
            milliseconds: 500

mode: single
max_exceeded: silent
